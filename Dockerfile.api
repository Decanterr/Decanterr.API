FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files for restore
COPY Directory.Build.props .
COPY global.json .
COPY Source/Decanterr.Api/Decanterr.Api.csproj Source/Decanterr.Api/
COPY Source/ApplicationServices/ApplicationServices.csproj Source/ApplicationServices/
COPY Source/AppScaffolding/AppScaffolding.csproj Source/AppScaffolding/
COPY Source/AudibleUtilities/AudibleUtilities.csproj Source/AudibleUtilities/
COPY Source/FileLiberator/FileLiberator.csproj Source/FileLiberator/
COPY Source/AaxDecrypter/AaxDecrypter.csproj Source/AaxDecrypter/
COPY Source/DataLayer/DataLayer.csproj Source/DataLayer/
COPY Source/DataLayer.Postgres/DataLayer.Postgres.csproj Source/DataLayer.Postgres/
COPY Source/DataLayer.Sqlite/DataLayer.Sqlite.csproj Source/DataLayer.Sqlite/
COPY Source/DtoImporterService/DtoImporterService.csproj Source/DtoImporterService/
COPY Source/FileManager/FileManager.csproj Source/FileManager/
COPY Source/LibationFileManager/LibationFileManager.csproj Source/LibationFileManager/
COPY Source/LibationSearchEngine/LibationSearchEngine.csproj Source/LibationSearchEngine/

RUN dotnet restore Source/Decanterr.Api/Decanterr.Api.csproj

# Copy full source
COPY Source/ Source/

# Build
RUN dotnet publish Source/Decanterr.Api/Decanterr.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Create volume directories
RUN mkdir -p /config /books /data

COPY --from=build /app/publish .

# Environment defaults
ENV ASPNETCORE_URLS=http://+:8080
ENV LibationFiles=/config
ENV BooksDirectory=/books
ENV ConnectionStrings__Postgres=""
ENV ApiKeys__0=CHANGE-ME-TO-A-SECURE-KEY

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

ENTRYPOINT ["dotnet", "Decanterr.Api.dll"]
